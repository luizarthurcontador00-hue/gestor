{
  "name": "gestor-vendas-desktop",
  "version": "0.86.0",
  "description": "Sistema de gestao de vendas desktop (Electron + Express + SQLite) - vendas, estoque, PDV, financeiro e relatorios. Uso local, com emissao fiscal opcional via gateway externo.",
  "author": "ContaFlow",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/luizarthurcontador00-hue/CONTAFLOW.git"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "server": "node src/backend/standalone.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.5.0",
    "multer": "^2.2.0",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "^0.18.5",
    "xml-crypto": "^6.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
